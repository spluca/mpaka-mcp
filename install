#!/usr/bin/env bash
set -Eeuo pipefail

readonly BASE_URL="https://mcp.mpaka.dev"
readonly RELEASE_PUBLIC_KEY_PEM='-----BEGIN PUBLIC KEY-----
MIIBojANBgkqhkiG9w0BAQEFAAOCAY8AMIIBigKCAYEA1srCWcBjUAB8hvCBTebp
nngaOwUnl+FFBWaU2VQ3WRNj+1tzxjLrRNKc3HEiOUD1TrgufNOoBV4r6/S7O6HW
77rqODhUQ3kixrOFXmzMzDoijsAjKjPknRyB3XkNKbrT/7pqbof5K336HQZz0XfZ
4wuAI2dRPJxsXcXiHGR+KlPJ4EI5/PzEN089qQfshR8yYm62I4/aD7CcrD0idTZS
eqZKki/vDRVsTR42DYFV+yDM4fWmWm2PD0vUMg/JblC9fH3MBEdBIwzth2u203Ih
Fb1UOc+sXLr0ryRimaaRZFFLXWykYNBZN2kt4AToM+rMrUWvN5x7siLwrKUE6veI
nrQM0A5yLBXB0f4AikiRHrcrLojSJR33dzuaeE23suOqyVQmN6DCFhvK+MNR7ObA
m/505u9v4v2XH/wUnNbIQ7bK/G2EK6VKLBKVqATfvLhqLyGBCJ/hehc4qLPEAXSy
NvI1xglPqlySwID/PK89+mYfpqEfLjIs/woEURx4a1FbAgMBAAE=
-----END PUBLIC KEY-----'
die() { printf 'mpaka-mcp installer: %s\n' "$*" >&2; exit 1; }
version=''
while (($#)); do
  case "$1" in
    --version) version="${2:-}"; shift 2 ;;
    --help|-h) printf 'Usage: install [--version vMAJOR.MINOR.PATCH]\n'; exit 0 ;;
    *) die "unknown option: $1" ;;
  esac
done
target_os="$(uname -s)"
target_arch="$(uname -m)"
case "$target_os:$target_arch" in
  Linux:x86_64) target='x86_64-unknown-linux-gnu' ;;
  Linux:aarch64|Linux:arm64) target='aarch64-unknown-linux-gnu' ;;
  Darwin:x86_64) target='x86_64-apple-darwin' ;;
  Darwin:arm64|Darwin:aarch64) target='aarch64-apple-darwin' ;;
  *) die "unsupported platform: $target_os $target_arch" ;;
esac
for command in curl openssl tar; do command -v "$command" >/dev/null 2>&1 || die "required command unavailable: $command"; done
if [[ -z "$version" ]]; then
  version="$(curl --silent --show-error --fail --proto '=https' --proto-redir '=https' "$BASE_URL/latest" | tr -d '\r\n')"
fi
[[ "$version" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "invalid release version: $version"
tmp="$(mktemp -d "${TMPDIR:-/tmp}/mpaka-mcp-install.XXXXXX")"
trap 'rm -rf "$tmp"' EXIT
curl --silent --show-error --fail --proto '=https' --proto-redir '=https' "$BASE_URL/releases/$version/manifest.json" --output "$tmp/manifest.json"
curl --silent --show-error --fail --proto '=https' --proto-redir '=https' "$BASE_URL/releases/$version/manifest.json.sig" --output "$tmp/manifest.json.sig"
printf '%s\n' "$RELEASE_PUBLIC_KEY_PEM" > "$tmp/public.pem"
openssl dgst -sha256 -verify "$tmp/public.pem" -signature "$tmp/manifest.json.sig" "$tmp/manifest.json" >/dev/null || die 'manifest signature verification failed'
manifest_version="$(sed -n 's/.*"version":"\(v[0-9][0-9.]*\)".*/\1/p' "$tmp/manifest.json")"
[[ "$manifest_version" == "$version" ]] || die 'manifest version mismatch'
line="$(sed -n "s/.*\"filename\":\"\([^\"]*\)\",\"sha256\":\"\([0-9a-f]\{64\}\)\",\"size\":\([0-9][0-9]*\),\"target\":\"$target\".*/\1\t\2\t\3/p" "$tmp/manifest.json")"
IFS=$'\t' read -r filename expected_hash expected_size <<< "$line"
[[ "$filename" == "mpaka-mcp-$version-$target.tar.gz" && -n "$expected_hash" ]] || die "manifest has no supported artifact for $target"
curl --silent --show-error --fail --proto '=https' --proto-redir '=https' "$BASE_URL/releases/$version/$filename" --output "$tmp/$filename"
actual_size="$(wc -c < "$tmp/$filename" | tr -d '[:space:]')"
[[ "$actual_size" == "$expected_size" ]] || die 'archive size mismatch'
if command -v sha256sum >/dev/null 2>&1; then
  actual_hash="$(sha256sum "$tmp/$filename" | awk '{print $1}')"
elif command -v shasum >/dev/null 2>&1; then
  actual_hash="$(shasum -a 256 "$tmp/$filename" | awk '{print $1}')"
else
  die 'required SHA-256 utility unavailable (need sha256sum or shasum)'
fi
[[ "$actual_hash" == "$expected_hash" ]] || die 'archive SHA-256 mismatch'
[[ "$(tar -tzf "$tmp/$filename")" == 'mpaka-mcp' ]] || die 'archive contains unexpected files'
mkdir "$tmp/extract"
tar -xzf "$tmp/$filename" -C "$tmp/extract" --no-same-owner
install_dir="${HOME:?}/.local/bin"
mkdir -p "$install_dir"
[[ ! -L "$install_dir" && ! -L "$install_dir/mpaka-mcp" ]] || die 'refusing installation through a symlink'
install -m 0755 "$tmp/extract/mpaka-mcp" "$install_dir/mpaka-mcp"
printf 'Installed mpaka-mcp %s for %s at %s/mpaka-mcp\n' "$version" "$target" "$install_dir"
case ":${PATH:-}:" in *":$install_dir:"*) ;; *) printf 'Add %s to PATH to run mpaka-mcp.\n' "$install_dir" ;; esac
