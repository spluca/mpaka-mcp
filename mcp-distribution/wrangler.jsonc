{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mpaka-mcp-distribution",
  "main": "src/index.js",
  "compatibility_date": "2026-11-26",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "mcp.mpaka.dev",
      "custom_domain": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "MCP_RELEASES",
      "bucket_name": "mpaka-mcp-releases"
    }
  ]
}
